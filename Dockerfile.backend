FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt requirements-ocr.txt ./
COPY docker/wheels/ /opt/wheels/
ARG INSTALL_OCR=true
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 5 --upgrade pip==26.2.1 && \
    if [ "$INSTALL_OCR" = "true" ]; then \
      set -- /opt/wheels/*.whl; \
      if [ -f "$1" ]; then \
        pip install --no-deps "$@"; \
      fi && \
      pip install --timeout 120 --retries 5 --resume-retries 10 --find-links /opt/wheels -r requirements-ocr.txt; \
    else \
      pip install --timeout 120 --retries 5 --resume-retries 10 -r requirements.txt; \
    fi

# Copy application code
COPY main.py ./
COPY ml ./ml
COPY integrations ./integrations
RUN useradd --create-home --uid 10001 careerlens
USER careerlens

# Expose port
EXPOSE 8001

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
