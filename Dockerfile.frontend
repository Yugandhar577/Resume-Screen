FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY app ./app
COPY data/review_examples.json ./data/review_examples.json
COPY lib ./lib
COPY public ./public
COPY next-env.d.ts ./
COPY next.config.js postcss.config.js tailwind.config.js tsconfig.json ./
ARG BACKEND_URL=http://backend:8001
ENV BACKEND_URL=$BACKEND_URL
ENV BUILD_STANDALONE=true NEXT_TELEMETRY_DISABLED=1

# Build the application
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node

# Expose port
EXPOSE 3000

# Start the application
CMD ["node", "server.js"]
