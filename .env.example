# CareerLens Environment Variables

# GROQ API (FREE & FAST)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Frontend
BACKEND_URL=http://127.0.0.1:8001
BACKEND_PORT=8001
BACKEND_HOST=127.0.0.1
# Optional access protection; use a unique random token of 32+ characters on private deployments.
API_AUTH_TOKEN=
# Explicitly trained local semantic experiment (ignored weights must be reproduced).
GAT_MODEL_DIR=ml/models/gat_experimental
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
