# CareerLens Environment Variables

# Local AI: no credentials or cloud fallback.
# Native setup uses loopback. Docker Compose sets http://ollama:11434 internally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONTEXT=8192
OLLAMA_TIMEOUT=300
# Optional 32+ character shared key when running more than one backend worker.
# Without it, proposal signatures expire when the backend restarts.
REVIEW_SIGNING_KEY=

# Frontend
BACKEND_URL=http://127.0.0.1:8001
BACKEND_PORT=8001
BACKEND_HOST=127.0.0.1
# Optional access protection; use a unique random token of 32+ characters on private deployments.
API_AUTH_TOKEN=
# Explicitly trained local semantic experiment (ignored weights must be reproduced).
GAT_MODEL_DIR=ml/models/gat_entities
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
